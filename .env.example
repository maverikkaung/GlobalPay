# Use a Supabase project owned by you. This key is public and is embedded in browser builds.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Backward-compatible variable name for existing deployments. Do not set both.
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_LEGACY_ANON_KEY
